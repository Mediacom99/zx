# Zhist hook
zx-hook() {
  local zx="$HOME/zx0.0.0"
  local out="$($zx)"
  # Only insert if output is not empty (ignoring whitespace)
  if [[ -n "${out//[[:space:]]/}" ]]; then
    BUFFER="$out"
    # Place cursor at end of buffer
    CURSOR=${#BUFFER}
  fi
  # If output is empty, leave BUFFER unchanged
  zle reset-prompt
}
# setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
unsetopt EXTENDED_HISTORY
zle -N zx-hook
bindkey '^g' zx-hook
